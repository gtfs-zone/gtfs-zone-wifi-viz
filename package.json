{
  "name": "gtfs-zone-wifi-viz",
  "version": "0.0.0",
  "description": "Static frontend that maps the wifi, cell and amenity data published by wifi.gtfs.zone",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run test",
    "lint": "eslint src/ tests/ vite.config.js --max-warnings 0",
    "lint:fix": "eslint src/ tests/ vite.config.js --fix",
    "format": "prettier --write src/ tests/ vite.config.js",
    "knip": "knip",
    "vuln": "sh scripts/vuln-gate.sh",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit",
    "wifi",
    "connectivity",
    "pmtiles"
  ],
  "author": "gtfs.zone contributors",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "gtfs-realtime-bindings": "^1.1.1",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.46",
    "gtfs-zone-vocab": "github:gtfs-zone/gtfs-zone-vocab#v0.1.0",
    "gtfs-zone-web-common": "github:gtfs-zone/gtfs-zone-web-common#v5.19.0",
    "jszip": "^3.10.2",
    "maplibre-gl": "^6.11.2",
    "papaparse": "^5.7.0",
    "pmtiles": "^4.5.0"
  }
}
